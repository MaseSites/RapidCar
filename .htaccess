# RapidCar, Apache-Konfiguration
# Funktioniert auf Apache und LiteSpeed (Hosttime). Die Anwendung bleibt auch
# ohne mod_rewrite voll funktionsfähig (physische .php-Dateien).

Options -Indexes

# ---------------------------------------------------------------------------
# Sensible Verzeichnisse und Dateien sperren
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------------
    # Immer verschluesselt. Der Webserver leitet um, noch bevor PHP laeuft:
    # das greift auch bei Dateien, die kein PHP anfassen (Bilder, CSS).
    # HTTP_X_FORWARDED_PROTO deckt den Fall ab, dass ein Proxy davor steht.
    # -----------------------------------------------------------------------
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\. [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Interne Ordner niemals ausliefern
    RewriteRule ^(src|config|includes|database|storage|lang)(/|$) - [F,L]

    # Hochgeladene Dateien laufen nie als Skript, egal was jemand hochlaedt
    RewriteRule ^uploads/.+\.(php|phtml|phar|pl|py|cgi|sh)$ - [F,L,NC]

    # -----------------------------------------------------------------------
    # Saubere Adressen: kein sichtbares .php.
    # Getippte .php-Adressen werden (nur bei GET) auf die endungslose Form
    # umgeleitet; Formulare und Schnittstellen (POST, /api/) bleiben unberuehrt,
    # eine Umleitung wuerde deren Daten verwerfen.
    # -----------------------------------------------------------------------
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[?\s]
    RewriteCond %1 !^api/
    RewriteCond %1 !^install/
    RewriteRule ^ /%1 [R=301,L]

    # Versteckte Dateien (.env, .git, …) sperren
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # -----------------------------------------------------------------------
    # Pretty-URLs (§66) → physische Dateien (§3). Optionaler Komfort.
    # -----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^features/?$ features.php [L]
    RewriteRule ^pricing/?$ pricing.php [L]
    RewriteRule ^about/?$ about.php [L]
    RewriteRule ^contact/?$ contact.php [L]
    RewriteRule ^login/?$ login.php [L]
    RewriteRule ^register/?$ register.php [L]
    RewriteRule ^confirm-email/?$ confirm-email.php [L]
    RewriteRule ^privacy/?$ privacy.php [L]
    RewriteRule ^imprint/?$ imprint.php [L]

    RewriteRule ^dashboard/?$ dashboard/index.php [L]
    RewriteRule ^dashboard/vehicles/?$ dashboard/vehicles.php [L]
    RewriteRule ^dashboard/vehicles/create/?$ dashboard/create-vehicle.php [L]
    RewriteRule ^dashboard/vehicles/([0-9]+)/?$ dashboard/vehicle.php?id=$1 [L,QSA]
    RewriteRule ^dashboard/leads/?$ dashboard/leads.php [L]
    RewriteRule ^dashboard/leads/([0-9]+)/?$ dashboard/lead.php?id=$1 [L,QSA]
    RewriteRule ^dashboard/social/?$ dashboard/social.php [L]
    RewriteRule ^dashboard/tasks/?$ dashboard/tasks.php [L]
    RewriteRule ^dashboard/settings/?$ dashboard/settings.php [L]
    RewriteRule ^dashboard/credits/?$ dashboard/credits.php [L]
    RewriteRule ^dashboard/channels/?$ dashboard/channels.php [L]

    RewriteRule ^admin/?$ admin/index.php [L]
    RewriteRule ^admin/users/?$ admin/users.php [L]
    RewriteRule ^admin/users/([0-9]+)/?$ admin/user.php?id=$1 [L,QSA]
    RewriteRule ^admin/vehicles/?$ admin/vehicles.php [L]
    RewriteRule ^admin/activity/?$ admin/activity.php [L]
    RewriteRule ^admin/settings/?$ admin/settings.php [L]

    # Alles Endungslose auf die passende .php-Datei abbilden (fuer alle
    # uebrigen Seiten und die Schnittstellen unter /api/)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# Fallback ohne mod_rewrite: Verzeichnisschutz über FilesMatch
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Archive, Datenbanken und Protokolle sind nie zum Herunterladen gedacht.
# Schuetzt auch ein versehentlich liegen gebliebenes Deploy-Paket.
<FilesMatch "\.(zip|tar|gz|sql|sqlite|sqlite-wal|sqlite-shm|log|bak)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Fehlerseiten (§67)
# ---------------------------------------------------------------------------
ErrorDocument 404 /errors/404.php
ErrorDocument 403 /errors/403.php
ErrorDocument 500 /errors/500.php

# ---------------------------------------------------------------------------
# PHP-Grundhärtung (falls vom Hosting erlaubt)
# ---------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

# Caching für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
